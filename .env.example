# Symposium — example .env. Copy to .env (./sym setup does it for you).
# Values here are STARTING defaults; after the first run most settings are edited
# in the admin panel and .env no longer overwrites them.

# ---------------------------------------------------------------- server
SYMPOSIUM_HOST=127.0.0.1
SYMPOSIUM_PORT=23606
# port of the separate UI listener (proxies /api to the backend); "off" — API port only
SYMPOSIUM_UI_PORT=23607
SYMPOSIUM_DATA_DIR=./data
SYMPOSIUM_LOG_LEVEL=INFO
# administrator password on first start (login: admin)
SYMPOSIUM_ADMIN_PASSWORD=admin

# --------------------------------------------- LLM provider (first profile)
# Created once when the profile table is empty; afterwards manage profiles in the admin panel.
SYMPOSIUM_BOOT_PROFILE_NAME=my-llm
SYMPOSIUM_BOOT_BASE_URL=https://openrouter.ai/api/v1
SYMPOSIUM_BOOT_API_KEY=
SYMPOSIUM_BOOT_MODEL=
# Limiter preset for this profile (empty = no limits). One of:
#   openrouter_free | openrouter_free_credits | mistral_free | serial_polite | none
# Limits of any profile can be edited in the admin panel; a preset is only a starting point.
SYMPOSIUM_BOOT_LIMITS_PRESET=

# --------------------------------------------------------------- RAG (Ollama)
SYMPOSIUM_OLLAMA_URL=http://localhost:11434
SYMPOSIUM_EMBEDDING_MODEL=nomic-embed-text
SYMPOSIUM_EMBEDDING_DIMS=768

# ------------------------------------------------------- web search (SearXNG)
# JSON API of your SearXNG instance (settings.yml: search.formats: [html, json]).
SYMPOSIUM_SEARXNG_URL=http://localhost:8080
# Search engines in priority order (JSON array). Empty — ["searxng","google","bing","yandex"].
SYMPOSIUM_WEB_SEARCH_ENGINES=

# ------------------------------------------------ code execution (workspace)
# Participants' code runs locally in the symposium's workspace: each one has its own
# Python virtual environment (pip install works) plus uploads/ (files you attach) and
# downloads/ (fetched from the internet). Settings live in the admin panel.
# pip and downloads honour HTTP_PROXY / HTTPS_PROXY from the environment.
