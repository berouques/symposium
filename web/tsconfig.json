{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "noUnusedLocals": false,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src"]
}
